<Window x:Class="WpfApp26._03._26.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp26._03._26"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--section 1-->
        <Label  Content="Lista sal" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="67" Width="247"/>
        <ListBox Name="nsala" Grid.RowSpan="4" Grid.Row="1" Grid.Column="0" Margin="10,10,10,10" HorizontalContentAlignment="Center">
            <ListBoxItem Height="40" Content="101"></ListBoxItem>
            <ListBoxItem Height="40" Content="102"></ListBoxItem>
            <ListBoxItem Height="40" Content="201"></ListBoxItem>
        </ListBox>
        <!--section 2-->
        <Label Grid.Column="1" Grid.Row="0" Content="Imię i nazwisko" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="246"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <TextBox Name="nosoba" Grid.Column="1" HorizontalAlignment="Center" Margin="0,43,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="246" Height="34"/>
        <Label Grid.Column="1" Grid.Row="1" Content="Data" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="246"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <DatePicker Name="ndata" Grid.Column="1" HorizontalAlignment="Center" Margin="0,43,0,0" Grid.Row="1" VerticalAlignment="Top" Width="246" Height="34"/>
        <Label Grid.Column="1" Grid.Row="2" Content="Godzina od" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="246"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <TextBox Name="ngodzina_od" Grid.Column="1" HorizontalAlignment="Center" Margin="0,42,0,0" Grid.Row="2" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="246" Height="34"/>
        <Label Grid.Column="1" Grid.Row="3" Content="Godzina do" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="246"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <TextBox Name="ngodzina_do" Grid.Column="1" HorizontalAlignment="Center" Margin="0,43,0,0" Grid.Row="3" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="246" Height="34"/>
        <Button Grid.Column="1" Content="Zarezerwuj" HorizontalAlignment="Center" Margin="0,22,0,0" Grid.Row="4" VerticalAlignment="Top" Width="246" Height="34" Click="Button_Click"/>
        <!--section 3-->

        <ListView Grid.Column="2" Margin="10,10,10,10" Grid.Row="1" Grid.RowSpan="4" x:Name="rezerw">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Sala" DisplayMemberBinding="{Binding Sala}"/>
                        <GridViewColumn Header="Osoba" DisplayMemberBinding="{Binding Osoba}"/>
                        <GridViewColumn Header="Data" DisplayMemberBinding="{Binding Data}"/>
                        <GridViewColumn Header="Godzina od" DisplayMemberBinding="{Binding GodzinaOd}"/>
                        <GridViewColumn Header="Godzina do" DisplayMemberBinding="{Binding GodzinaDo}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Grid.Column="2" Content="Filtruj wedlug:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="85"/>
        <ComboBox Grid.Column="2" HorizontalAlignment="Left" Margin="100,10,0,0" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="55" Height="26" SelectionChanged="ComboBox_SelectionChanged">
            <ComboBoxItem Name="Sala" Content="Sala" IsSelected="True"/>
            <ComboBoxItem Name="Data" Content="Data"/>
        </ComboBox>
        <TextBox TextChanged="Filter_on" Name="filtr" Grid.Column="2" HorizontalAlignment="Left" Margin="160,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="26"/>
        <Button Name="usun" Grid.Column="2" Content="Usuń" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" Height="26" Click="usun_Click"/>

    </Grid>
</Window>
